<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>StructureEditor</AssemblyName>
    <RootNamespace>StructureEditor</RootNamespace>
    <Product>Structure Editor · 结构工坊</Product>
    <Version>0.14.0</Version>
    <DefineConstants Condition="Exists('$(MPClusterNamingSource)')">$(DefineConstants);SHARED_MP_NAMING</DefineConstants>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon Condition="Exists('../../branding/StructureEditor.ico')">../../branding/StructureEditor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MPClusterNamingSource)')">
    <Compile Remove="Compatibility/MP_ClusterNaming.cs" />
    <Compile Include="$(MPClusterNamingSource)" Link="Compatibility/Shared/MP_ClusterNaming.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../branding/GoldenCube.png')">
    <EmbeddedResource Include="../../branding/GoldenCube.png" LogicalName="StructureEditor.Branding.GoldenCube.png" />
  </ItemGroup>
</Project>
